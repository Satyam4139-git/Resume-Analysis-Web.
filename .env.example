# Copy this file to .env and fill in your own values. Never commit .env.

# ---- AI (required) ----
OPENROUTER_API_KEY=your_openrouter_api_key_here
MODEL_NAME=nvidia/nemotron-3-super-120b-a12b:free
MAX_OUTPUT_TOKENS=1200
RESUME_PARSER_MAX_TOKENS=4000
AI_REVIEW_MAX_TOKENS=2000
TEMPERATURE=0.2
DEVELOPMENT_MODE=false

# ---- Job search ----
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here
ADZUNA_COUNTRY=in
ADZUNA_RESULTS_PER_PAGE=10
MAX_JOB_RESULTS=20
INDIA_FIRST_JOBS=true
INDIAN_COMPANY_BOOST=20
INDIAN_LOCATION_BOOST=10

# ---- Login (Google) ----
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
SESSION_SECRET=replace_with_a_long_random_secret

# ---- Site address ----
# Leave these blank on Render: they are detected automatically.
# Locally, the defaults (http://127.0.0.1:8000) already work.
BASE_URL=http://127.0.0.1:8000
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
FRONTEND_URL=http://127.0.0.1:8000

# ---- Saved applications (SQLite) ----
# Point at a persistent disk to keep data across deploys, e.g. /var/data/applications.db
DATABASE_PATH=applications.db
